node_modules
dist
*.local
.DS_Store

# Browser test scaffold, regenerated by tooling; never ship it
public/__harness.js

# Workflow scripts, kept out of the published repo
.workflows/
NEXT.md
.vercel
.env*

# Throwaway inspection scripts used while laying out the presets
scratch-*.ts

# Local Claude Code permissions, per-machine and not part of the project
.claude/settings.local.json

# Playwright artifacts. Baselines are NOT ignored: they are committed, per
# platform, and tests/visual/README.md is the contract for refreshing them.
test-results/
playwright-report/

# Wrangler's local state. The cache under it records the machine that ran
# it, down to the city and the ISP, so it is per-machine and private.
.wrangler/
worker/.wrangler/
.dev.vars*

# The extension's build output. media/ is the webview bundle, dist/ is the
# bundled host, and the .vsix is the two of them zipped: all three are
# rebuilt by `bun run build:extension` and none belongs in the history.
extension/media/
extension/dist/
extension/*.vsix

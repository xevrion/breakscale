{
  "name": "breakscale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "prepare": "husky",
    "test:visual": "bunx playwright test",
    "test:visual:update": "bunx playwright test --update-snapshots",
    "test:visual:ui": "bunx playwright test --ui",
    "test:visual:bisect": "bunx playwright test --bisect",
    "generate-baselines": "bun tests/visual/setup.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "description": "Build a system, load it until it breaks, and watch why",
  "repository": {
    "type": "git",
    "url": "https://github.com/xevrion/breakscale.git"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,md}": "prettier --write"
  }
}

# Editor defaults, so a contributor's setup does not fight Prettier.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown gives meaning to trailing spaces (a hard line break).
trim_trailing_whitespace = false
